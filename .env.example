# Copie para .env e ajuste os valores.

# Banco local do docker-compose (porta 5433)
DATABASE_URL="postgresql://cardapio:cardapio@localhost:5433/cardapio_certo?schema=public"

# Segredo da sessão, mínimo 32 caracteres (gere com: openssl rand -base64 32)
AUTH_SECRET=""

# Usuário gestor criado pelo seed (npx prisma db seed). Senha com 8+ caracteres.
SEED_ADMIN_NOME="Gestor"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_SENHA=""
